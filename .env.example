# .env 로 복사해서 사용하세요: cp .env.example .env
AWS_ACCESS_KEY_ID=AK...
AWS_SECRET_ACCESS_KEY=k...
AWS_DEFAULT_REGION=us-east-1

# 선택 - 서브그래프별 Bedrock 모델 ID 오버라이드 (기본값이면 생략 가능, src/config.py 참고)
# 기본값은 Sonnet 3개 버킷(Supervisor/research_agent/budget_agent 전담) + Haiku 2개 버킷
# (classify_complexity 판정 라우터 / tracking_agent) 로 역할별 분산되어 있다 - 한 모델 ID에
# 여러 역할이 몰리면 Bedrock의 모델별 일일 토큰 한도(ThrottlingException)에 더 쉽게 걸린다.
# 예: COMPASS_MODEL_SUPERVISOR=global.anthropic.claude-sonnet-4-6
